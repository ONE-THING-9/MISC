from google.cloud import aiplatform

def run_batch_job(project, location, model_id, input_uri, output_uri):
    client = aiplatform.gapic.JobServiceClient(
        client_options={"api_endpoint": f"{location}-aiplatform.googleapis.com"}
    )

    batch_request = {
        "display_name": "python-batch-gemini",
        "model": f"projects/{project}/locations/{location}/models/{model_id}",
        "input_config": {
            "instances_format": "jsonl",
            "gcs_source": {"uris": [input_uri]},
        },
        "output_config": {
            "predictions_format": "jsonl",
            "gcs_destination": {"output_uri_prefix": output_uri},
        },
    }

    response = client.create_batch_prediction_job(
        parent=f"projects/{project}/locations/{location}",
        batch_prediction_job=batch_request,
    )
    print("Batch job started:", response.name)

# Example
run_batch_job(
    project="your-gcp-project",
    location="us-central1",
    model_id="gemini-2.5-flash",
    input_uri="gs://your-bucket/batch_inputs/batch_input.jsonl",
    output_uri="gs://your-bucket/batch_outputs/"
)
