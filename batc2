from google.cloud import storage

def upload_file(bucket_name, source_file, dest_path):
    client = storage.Client()
    bucket = client.bucket(bucket_name)
    blob = bucket.blob(dest_path)
    blob.upload_from_filename(source_file)
    print(f"Uploaded {source_file} to gs://{bucket_name}/{dest_path}")

# Example usage
upload_file(
    bucket_name="YOUR_BUCKET_NAME",
    source_file="local_file.jsonl",
    dest_path="batch_inputs/local_file.jsonl"
)


